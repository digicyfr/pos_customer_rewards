<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_customer_rewards.PaymentScreenButtons"
       t-inherit="point_of_sale.PaymentScreenButtons"
       t-inherit-mode="extension">
        <xpath expr="//button[contains(@class, 'js_invoice')]" position="after">
            <button t-if="loyaltyButtonVisible"
                    class="button loyalty-button btn btn-light py-3 text-start rounded-0 border-bottom"
                    t-on-click="clickLoyaltyButton">
                <i class="fa fa-gift me-2"></i>
                <span>Use Points</span>
            </button>
        </xpath>
    </t>

</templates>
